{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jshs",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": true
  },
  "ai": {
    "binding": "AI"
  },
  "routes": [
    {
      "pattern": "jshs.cc/*",
      "zone_id": "2700357d9e2674d41286c7d39452e50e"
    }
  ],
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "CORE_DB",
      "database_name": "jshs-core",
      "database_id": "534a20dd-0797-4a86-bdea-c83cff4c567f"
    },
    {
      "binding": "LEARNING_DB",
      "database_name": "jshs-learning",
      "database_id": "b9e54eaa-eb70-44ce-b770-a555b2e30198"
    },
    {
      "binding": "COMMUNITY_DB",
      "database_name": "jshs-community",
      "database_id": "6ba329ac-cb11-43f8-9d42-ebb50ea0772c"
    }
  ]
}
