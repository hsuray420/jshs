{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jshs",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "no_bundle": true,
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS"
  },
  "routes": [
    {
      "pattern": "jshs.cc",
      "custom_domain": true
    },
    {
      "pattern": "www.jshs.cc",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jshs-db",
      "database_id": "ab07d794-b69b-44bf-bd20-8854870c7bd7"
    }
  ]
}
