    {"field_id":"no_truancy_semesters","label":"無曠課學期數","category":"多元學習表現","subcategory":"日常生活表現評量","input_type":"semester_count","options":[],"unit":"學期","min":0,"max":6,"score_per_unit":2,"score_cap":12,"calculation":"score = min(no_truancy_semesters*2,12)","conditions":["整學期無曠課"],"dependencies":[],"mutually_exclusive":[],"adopted_period":"七上至九下，共6學期；九下至115年4月20日","evidence_required":true,"evidence_description":"學校出缺席紀錄。","helper_text":"七上至九下每一學期完全沒有曠課計2分，最多6學期12分；九下只採計到115年4月20日。","official_rule":"每學期無曠課2分，最多12分。","validation":{"required":true,"type":"integer","min":0,"max":6,"error_message":"請輸入0～6之間的整數"},"source_ids":["HHM-115-002"]},
