    {"field_id":"service_hours_grade7_first","label":"七上服務學習時數","category":"多元學習表現","subcategory":"服務學習","input_type":"hours","options":[],"unit":"小時","min":0,"max":null,"score_per_unit":null,"score_cap":2,"calculation":"score = min(floor(hours/3),2)","conditions":["校內或校外服務須依官方認定程序"],"dependencies":[],"mutually_exclusive":[],"adopted_period":"七年級上學期","evidence_required":true,"evidence_description":"學校認定之服務學習紀錄。","helper_text":"七上每滿3小時計1分，本學期最多2分；不足3小時不計，簡章未允許把不足時數移到別學期。","official_rule":"每學期每服務滿3小時1分，每學期最多2分。","validation":{"required":true,"type":"decimal","min":0,"error_message":"請輸入0以上時數"},"source_ids":["HHM-115-002"]},
