  "derived_scores":{
    "balanced_learning_score":"count = sum([balanced_health_pe, balanced_arts, balanced_integrated, balanced_technology]); score = {0:0,1:4,2:8,3:12,4:15}[count]",
    "balanced_development_raw":"disadvantaged_score + nearby_score + preference_score + balanced_learning_score",
    "balanced_development_score":"min(balanced_development_raw,30)",
    "reward_score":"min(major_merit_count*4.5 + minor_merit_count*1.5 + commendation_count*0.5,20)",
    "service_score":"sum(min(floor(each_semester_hours/3),2))",
    "multiple_learning_raw":"discipline_score + no_truancy_score + reward_score + service_score + local_language_score",
    "multiple_learning_score":"min(multiple_learning_raw,40)"
