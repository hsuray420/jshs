    {"field_id":"nearby_eligibility","label":"就近入學資格","category":"適性輔導","subcategory":"就近入學","input_type":"radio","options":[{"label":"不符合","value":"none","score":0},{"label":"戶籍或國中學籍在桃園／連江","value":"general","score":5},{"label":"符合核定共同就學區","value":"common","score":5}],"unit":"分","min":null,"max":null,"score_per_unit":null,"score_cap":5,"calculation":"score=value=='none'?0:5","conditions":["戶籍或國中學籍在桃園市或連江縣，或符合共同就學區"],"dependencies":["household_area","junior_high_school_id","target_school_id"],"mutually_exclusive":["none","general","common"],"adopted_period":"115學年度報名資格審查時","evidence_required":true,"evidence_description":"戶籍、學籍或共同就學區核定對照。","helper_text":"戶籍或國中學籍在桃園、連江，或來源國中與目標學校符合115共同就學區對照，計5分。","official_rule":"符合本區或共同就學區就近資格者5分。","validation":{"required":true,"type":"string","enum":["none","general","common"],"error_message":"請選擇就近入學資格。"},"source_ids":["TYC-115-002","TYC-115-004"]},
