    {"field_id":"discipline_after_cancellation","label":"銷過後懲處狀態","category":"多元學習表現","subcategory":"品德表現／無懲處","input_type":"radio","options":[{"label":"無懲處或不超過2次警告","value":"qualified","score":6},{"label":"超過2次警告或仍有較重懲處","value":"not_qualified","score":0}],"unit":"分","min":null,"max":null,"score_per_unit":null,"score_cap":6,"calculation":"score=value=='qualified'?6:0","conditions":["以銷過及獎懲相抵後紀錄判定"],"dependencies":["demerit_records","cancellation_records"],"mutually_exclusive":["qualified","not_qualified"],"adopted_period":"七年級入學至115年5月8日採計截止","evidence_required":false,"evidence_description":"學校銷過後正式獎懲紀錄。","helper_text":"以銷過及相抵後紀錄判定；無懲處或最多2次警告計6分，超過即0分。品德表現獎勵加本項最多10分。","official_rule":"銷過後無懲處或不超過2次警告計6分。","validation":{"required":true,"type":"string","enum":["qualified","not_qualified"],"error_message":"請選擇銷過後狀態。"},"source_ids":["TYC-115-002"]},
    {"field_id":"qualified_cadre_semesters","label":"符合規定的幹部學期數","category":"多元學習表現","subcategory":"服務學習／幹部","input_type":"semester_count","options":[],"unit":"學期","min":0,"max":6,"score_per_unit":2,"score_cap":4,"calculation":"score=min(count*2,4)","conditions":["班級、學生自治市或社團幹部","完整一學期","表現優良並經學校認證"],"dependencies":[],"mutually_exclusive":[],"adopted_period":"七年級入學至115年5月8日採計截止","evidence_required":false,"evidence_description":"學校幹部與表現優良認證。","helper_text":"班級、學生自治市或社團幹部須任滿一學期且表現優良；每學期2分，幹部部分最多4分。","official_rule":"合格幹部每學期2分，幹部上限4分。","validation":{"required":true,"type":"integer","min":0,"max":6,"error_message":"請輸入0～6學期。"},"source_ids":["TYC-115-002"]},
    {"field_id":"certified_service_hours","label":"認證志願服務時數","category":"多元學習表現","subcategory":"服務學習／時數","input_type":"hours","options":[],"unit":"小時","min":0,"max":null,"score_per_unit":0.3,"score_cap":10,"calculation":"score=floor(hours)*0.3; service_score=min(cadre_score+score,10)","conditions":["須經學校認證","不足1小時部分捨去"],"dependencies":["qualified_cadre_semesters"],"mutually_exclusive":[],"adopted_period":"七年級入學至115年5月8日採計截止","evidence_required":false,"evidence_description":"學校認證服務紀錄。","helper_text":"每滿1小時計0.3分，不足1小時捨去；再與幹部積分合計，服務學習最多10分。","official_rule":"服務每滿1小時0.3分；服務學習合計上限10分。","validation":{"required":true,"type":"decimal","min":0,"error_message":"請輸入0以上時數。"},"source_ids":["TYC-115-002"]},
