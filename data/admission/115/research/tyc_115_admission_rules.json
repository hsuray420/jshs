    {"field_id":"major_merit_count","label":"大功次數","category":"多元學習表現","subcategory":"品德表現／獎勵","input_type":"integer","options":[],"unit":"次","min":0,"max":null,"score_per_unit":4.5,"score_cap":6,"calculation":"reward_raw+=count*4.5; reward_score=min(reward_raw_after_offset,6)","conditions":["獎懲先依官方規則相抵"],"dependencies":["minor_merit_count","commendation_count","demerit_records"],"mutually_exclusive":[],"adopted_period":"七年級入學至115年5月8日採計截止","evidence_required":false,"evidence_description":"校務獎懲系統。","helper_text":"每次大功4.5分；須與其他獎勵及懲處依官方規則相抵，獎勵部分最多6分，品德表現合計最多10分。","official_rule":"大功每次4.5分，獎勵上限6分。","validation":{"required":true,"type":"integer","min":0,"error_message":"請輸入0以上整數。"},"source_ids":["TYC-115-002"]},
