{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "pnpm run generate:data-foundation && pnpm run generate:admission-history && pnpm run generate:vocational-groups && pnpm run generate:school-directory && pnpm run validate:data-foundation && pnpm run generate:sitemap && pnpm run generate:guide-css && pnpm run generate:legal-documents && pnpm run generate:source-snapshot && WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build && node scripts/publish-app-css.mjs",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "pnpm run validate:content && pnpm run typecheck && pnpm run build && node --experimental-strip-types --test tests/*.test.mjs",
    "test:unit": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit --incremental false",
    "validate:content": "node scripts/validate-content-trust.mjs",
    "validate:data-foundation": "node scripts/validate-data-foundation.mjs",
    "generate:data-foundation": "node scripts/generate-data-foundation.mjs",
    "generate:vocational-groups": "node scripts/generate-vocational-groups.mjs",
    "validate:production": "node scripts/check-production-placeholders.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .wrangler",
    "generate:source-snapshot": "node scripts/generate-source-snapshot.mjs",
    "generate:admission-history": "node scripts/generate-admission-history.mjs",
    "generate:school-directory": "node scripts/generate-school-directory.mjs",
    "generate:guide-css": "node scripts/generate-guide-tailwind.mjs",
    "generate:legal-documents": "node scripts/generate-legal-documents.mjs",
    "generate:sitemap": "node scripts/generate-sitemap.mjs",
    "db:generate": "drizzle-kit generate",
    "cloudflare:deploy": "node scripts/cloudflare-deploy.mjs",
    "cloudflare:deploy:direct": "node scripts/cloudflare-deploy-direct.mjs",
    "cloudflare:watch": "node scripts/cloudflare-watch.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "leaflet": "^1.9.4",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.51.0",
    "@cloudflare/workers-types": "5.20260807.2",
    "@tailwindcss/postcss": "4.2.1",
    "@types/leaflet": "^1.9.22",
    "@types/node": "22.19.19",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "@vitejs/plugin-rsc": "0.5.34",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.0",
    "postcss": "8.5.25",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.16",
    "wrangler": "4.119.0"
  },
  "type": "module"
}
