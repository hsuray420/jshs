{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "pnpm run generate:source-snapshot && WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "pnpm run validate:content && pnpm run typecheck && pnpm run build && node --test tests/*.test.mjs",
    "test:unit": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit --incremental false",
    "validate:content": "node scripts/validate-content-trust.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "generate:source-snapshot": "node scripts/generate-source-snapshot.mjs",
    "db:generate": "drizzle-kit generate",
    "cloudflare:deploy": "node scripts/cloudflare-deploy.mjs",
    "cloudflare:deploy:direct": "node scripts/cloudflare-deploy-direct.mjs",
    "cloudflare:watch": "node scripts/cloudflare-watch.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.51.0",
    "@cloudflare/workers-types": "5.20260807.2",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "@vitejs/plugin-rsc": "0.5.34",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.0",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.16",
    "wrangler": "4.119.0"
  },
  "type": "module"
}
